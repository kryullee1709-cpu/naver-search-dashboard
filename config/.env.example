# ============================================================
# NAVER API HUB 인증 정보
# https://api.ncloud-docs.com/docs/naver-api-hub-overview
# ------------------------------------------------------------
# 1) 이 파일을 프로젝트 루트에 .env 로 복사하세요.
#    cp config/.env.example .env
# 2) 발급받은 키를 채워 넣으세요.
# ============================================================

# --- 인증 방식: hub (NAVER API HUB / 네이버 클라우드 플랫폼) 또는 legacy (네이버 개발자센터) ---
NAVER_AUTH_MODE=hub

# --- hub 모드: 네이버 클라우드 플랫폼에서 발급한 Client ID / Secret ---
# 요청 헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 로 전송됩니다.
NAVER_CLIENT_ID=여기에_Client_ID를_입력하세요
NAVER_CLIENT_SECRET=여기에_Client_Secret을_입력하세요

# --- legacy 모드(선택): 기존 네이버 개발자센터 애플리케이션 키 ---
# 요청 헤더 X-Naver-Client-Id / X-Naver-Client-Secret 로 전송됩니다.
# NAVER_LEGACY_CLIENT_ID=
# NAVER_LEGACY_CLIENT_SECRET=

# --- 엔드포인트 (기본값 사용을 권장, 필요 시 재정의) ---
# hub 기본값
NAVER_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
# 검색어 트렌드 호스트(기본값은 검색과 동일).
NAVER_TREND_BASE_URL=https://naverapihub.apigw.ntruss.com
# legacy 기본값
NAVER_LEGACY_BASE_URL=https://openapi.naver.com
