# ============================================================
# Streamlit Secrets (배포용)
# ------------------------------------------------------------
# .env 파일은 저장소에 올라가지 않으므로 Streamlit Community Cloud 에서는
# 이 내용을 앱 설정에 직접 붙여넣어야 한다.
#   앱 화면 우측 상단 ⋮ → Settings → Secrets → 아래 내용 붙여넣기 → Save
#
# 로컬에서 Secrets 로 테스트하려면 이 파일을 .streamlit/secrets.toml 로
# 복사한다 (.gitignore 에 이미 제외되어 있음).
#   cp config/secrets.toml.example .streamlit/secrets.toml
# ============================================================

NAVER_AUTH_MODE = "hub"
NAVER_CLIENT_ID = "여기에_Client_ID를_입력하세요"
NAVER_CLIENT_SECRET = "여기에_Client_Secret을_입력하세요"

# 엔드포인트는 기본값을 쓰면 되므로 보통 생략한다.
# NAVER_HUB_BASE_URL = "https://naverapihub.apigw.ntruss.com"
# NAVER_TREND_BASE_URL = "https://naverapihub.apigw.ntruss.com"

# legacy(네이버 개발자센터) 키를 쓸 경우
# NAVER_AUTH_MODE = "legacy"
# NAVER_LEGACY_CLIENT_ID = ""
# NAVER_LEGACY_CLIENT_SECRET = ""
